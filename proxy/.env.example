# El proxy NO lee este archivo: las variables se definen en la terminal antes de encenderlo.
# Ejemplo (Mac/Linux):   export GEMINI_API_KEY="tu-clave"   y luego   node proxy/proxy.js
# Sin GEMINI_API_KEY el proxy funciona en modo REGLAS.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
BACKEND_URL=http://localhost:8000
PORT=3000
