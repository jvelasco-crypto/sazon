# Copia este archivo como .env y cambia los valores. Nunca subas .env a git.
# Genera tu clave con:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO
# Credenciales de la base de datos de Docker (solo desarrollo local)
POSTGRES_USER=sazon
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=sazon
